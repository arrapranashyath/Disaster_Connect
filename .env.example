# ==============================================================================
# DisasterConnect - Environment Variables Example Template
# Copy this file to .env or export these variables in your shell / IDE:
# ==============================================================================

# Database Configuration
export DB_URL="jdbc:mysql://localhost:3306/disaster_connect_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC"
export DB_USERNAME="root"
export DB_PASSWORD="your_mysql_password_here"

# Server Port
export SERVER_PORT="8080"

# JWT Authentication Configuration
# DO NOT use a predictable default secret.
# Generate a cryptographically secure 256-bit (32+ bytes) random key by running:
#   openssl rand -base64 32
export JWT_SECRET="<generate_with_openssl_rand_base64_32>"
export JWT_EXPIRATION_MS="86400000"
